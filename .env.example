# --- Groq (free tier works): transcription + LLM with ONE key ---
# https://console.groq.com/keys
GROQ_API_KEY=

# --- LLM (any OpenAI-compatible endpoint) ---
# Default: Groq free tier. To switch, change these three lines, e.g.
#   Claude:     LLM_BASE_URL=https://api.anthropic.com/v1/   LLM_MODEL=claude-haiku-4-5   LLM_API_KEY=sk-ant-...
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1    LLM_MODEL=<model id>         LLM_API_KEY=sk-or-...
#   Ollama:     LLM_BASE_URL=http://ollama:11434/v1          LLM_MODEL=qwen3:14b          LLM_API_KEY=ollama
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# empty = use GROQ_API_KEY
LLM_API_KEY=

# --- Transcription (OpenAI-compatible Whisper endpoint) ---
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3
# empty = use GROQ_API_KEY
STT_API_KEY=

# --- Review app login (HTTP basic auth). CHANGE THIS. ---
APP_USER=admin
APP_PASSWORD=change-me

# Where all data lives (inside the container)
DATA_DIR=/data
